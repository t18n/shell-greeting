#!/bin/sh
# Random quote from quotes/ with a random graphic in one of four flavors:
# art (ASCII), pixel (pixel art), braille (braille line art) or image (real pictures).
# Only POSIX sh and awk, so any shell on macOS, Linux, BSD or WSL can run it.
# Settings come from GREETING_* environment variables; see "Configuration" in README.md.

dir=$(cd "$(dirname "$0")" && pwd)
seed=$(od -An -N4 -tu4 /dev/urandom | tr -d ' ')
read -r today hour weekday <<EOF
$(date '+%Y%m%d %H %u')
EOF
VERSION=1.0.0

usage() {
  cat <<'HELP'
Usage: greeting [options] [graphic files...]

Shows a random quote with a random graphic. Graphic files given as arguments
are the only ones it picks from; their folder decides the flavor.

Options:
  -f, --flavor NAME   art, pixel, braille, image or random
  -l, --list          show content folders, quote topics and graphics, then exit
      --force         print even when the output is not a terminal
  -h, --help          show this help
  -V, --version       show the version

Settings are GREETING_* environment variables; see "Configuration" in the README.
HELP
}

flavor=${GREETING_FLAVOR:-random} list='' force=''
while [ $# -gt 0 ]; do
  case $1 in
    -f | --flavor)
      [ $# -ge 2 ] || { echo "greeting: $1 needs a flavor name (try --help)" >&2; exit 2; }
      flavor=$2; shift 2 ;;
    --flavor=*) flavor=${1#--flavor=}; shift ;;
    -l | --list) list=1; shift ;;
    --force) force=1; shift ;;
    -h | --help) usage; exit 0 ;;
    -V | --version) echo "shell-greeting $VERSION"; exit 0 ;;
    --) shift; break ;;
    -?*) echo "greeting: unknown option $1 (try --help)" >&2; exit 2 ;;
    *) break ;;
  esac
done

# Stay quiet when the output is not a terminal, so scp, rsync or "ssh host command" never get a
# greeting mixed into their output.
[ -t 1 ] || [ -n "$force$list" ] || exit 0

# Content comes from this folder plus each folder in GREETING_DIRS (separated by ":"), which
# defaults to ~/.config/shell-greeting. Every folder has the same layout: quotes/ and graphics/.
roots=$dir
IFS=:
for d in ${GREETING_DIRS-${XDG_CONFIG_HOME:-$HOME/.config}/shell-greeting}; do
  [ -d "$d" ] && [ "$d" != "$dir" ] && roots="$roots:$d"
done

if [ $# -eq 0 ]; then
  for r in $roots; do
    set -- "$@" "$r"/graphics/art/*.txt "$r"/graphics/pixel/*.txt "$r"/graphics/braille/*.txt \
      "$r"/graphics/images/*.png "$r"/graphics/images/*.jpg "$r"/graphics/images/*.jpeg
  done
fi

# The quote files go first in the argument list; awk gets their count to tell them apart.
# GREETING_TOPICS keeps only the named topic files; if none of them exists, every topic is used.
topics=" $(printf '%s' "$GREETING_TOPICS" | tr ',' ' ') "
nq=0
for pass in topics all; do
  for r in $roots; do
    for f in "$r"/quotes/*.txt; do
      [ -f "$f" ] || continue
      t=${f##*/}
      case $pass$topics in all* | "topics  " | *" ${t%.txt} "*) set -- "$f" "$@"; nq=$((nq + 1)) ;; esac
    done
  done
  [ "$nq" -gt 0 ] && break
done
unset IFS

# Real images need chafa, or a terminal that shows images itself (iTerm2, WezTerm).
imager=none
if command -v chafa >/dev/null 2>&1; then
  imager=chafa
elif [ -z "$TMUX" ] && { [ "$TERM_PROGRAM" = iTerm.app ] || [ "$TERM_PROGRAM" = WezTerm ]; }; then
  imager=iterm
fi

if [ -n "$list" ]; then
  echo "shell-greeting $VERSION"
  echo "Content folders:"
  IFS=:
  for r in $roots; do echo "  $r"; done
  echo "Quote topics:"
  for r in $roots; do for f in "$r"/quotes/*.txt; do [ -f "$f" ] && echo "$f"; done; done |
    while read -r f; do awk 'FNR == 1 || $0 == "%" { n++ } END { t = FILENAME; sub(/.*\//, "", t); sub(/\.txt$/, "", t); print t, n }' "$f"; done |
    awk '{ n[$1] += $2; total += $2 } END { for (t in n) printf "  %-14s %4d\n", t, n[t] | "sort"; close("sort"); printf "  %-14s %4d\n", "total", total }'
  echo "Graphics by flavor:"
  for kind in art pixel braille images; do
    n=0
    for r in $roots; do
      for f in "$r/graphics/$kind"/*; do [ -f "$f" ] && n=$((n + 1)); done
    done
    case $kind in
      images) note="real images through $imager"; [ "$imager" = none ] && note="needs chafa, iTerm2 or WezTerm; falls back to pixel" ;;
      *) note='' ;;
    esac
    printf '  %-14s %4d%s\n' "${kind%s}" "$n" "${note:+  $note}"
  done
  unset IFS
  exit 0
fi

count=0 uptime='' disk=0
if [ "$GREETING_FACTS" != off ]; then
  # Terminals opened today. This is the only thing written to disk: a date and a count.
  state=${XDG_STATE_HOME:-$HOME/.local/state}/shell-greeting
  count=1
  if [ -r "$state/count" ]; then
    read -r day n < "$state/count"
    case $n in '' | *[!0-9]*) ;; *) [ "$day" = "$today" ] && count=$((n + 1)) ;; esac
  fi
  mkdir -p "$state" 2>/dev/null && { echo "$today $count" > "$state/count"; } 2>/dev/null
  uptime=$(uptime 2>/dev/null)
  disk=$(df -P "$HOME" 2>/dev/null | awk 'NR == 2 { print $5 + 0 }')
fi

exec awk -v nq="$nq" -v seed="$seed" -v hour="$hour" -v weekday="$weekday" -v mmdd="${today#????}" \
  -v flavor="$flavor" -v imager="$imager" -v count="$count" -v uptime="$uptime" -v disk="$disk" \
  -v name="${GREETING_NAME:-${USER:-$(id -un)}}" '
BEGIN {
  srand(seed)
  WIDTH = 50
  offset = int(rand() * 256)
  odds = ENVIRON["GREETING_SHINY"] == "" ? 50 : ENVIRON["GREETING_SHINY"] + 0
  shiny = odds > 0 && rand() < 1 / odds
  truecolor = ENVIRON["COLORTERM"] ~ /^(truecolor|24bit)$/
  # NO_COLOR (https://no-color.org): no color codes at all, and no flavors that are only color
  nocolor = ENVIRON["NO_COLOR"] != ""
  RESET = nocolor ? "" : "\033[0m"
  for (i = nq + 1; i < ARGC; i++) {
    if (ARGV[i] !~ /\*/) files[++nfiles] = ARGV[i]
    ARGV[i] = ""
  }
}

# Quote files use the fortune format: entries separated by a line containing only "%"
FNR == 1 && entry != "" { quotes[++nquotes] = entry; entry = "" }
$0 == "%" { if (entry != "") quotes[++nquotes] = entry; entry = ""; next }
{ if (entry == "") entry = $0; else entry = entry "\n" $0 }

END {
  if (entry != "") quotes[++nquotes] = entry
  quote = quotes[int(rand() * nquotes) + 1]
  if (hour >= 1 && hour < 5 && ENVIRON["GREETING_NIGHT"] != "off") quote = nudge()
  n = split(quote, lines, "\n")
  for (i = 1; i <= n; i++) wrap(lines[i])

  file = choose()
  if (ENVIRON["GREETING_HELLO"] != "off") say(greeting())
  if (style == "art") { bubble(); art(file) }
  else if (style == "pixel") { box("\342\225\255", "\342\225\256", "\342\225\260", "\342\225\257", ""); tail("\342\225\262"); sprite(file) }
  else if (style == "braille") { box("\342\224\214", "\342\224\220", "\342\224\224", "\342\224\230", "\342\224\254"); tail("\342\224\202"); art(file) }
  else { card(); image(file) }
  if (ENVIRON["GREETING_FACTS"] != "off") say("   " fact())
  if (shiny) say("      * shiny! *")
}

# The awk program sits inside single quotes, so its messages avoid apostrophes.
function pick(options,    n, a) {
  n = split(options, a, "|")
  return a[int(rand() * n) + 1]
}

function flavor_of(path) {
  if (path ~ /\.(png|jpe?g)$/) return "image"
  if (path ~ /\/pixel\/[^\/]*$/) return "pixel"
  if (path ~ /\/braille\/[^\/]*$/) return "braille"
  return "art"
}

# Picks the flavor (from GREETING_FLAVOR, --flavor or GREETING_WEIGHTS), then a graphic in it.
# A flavor with no graphics, or images without a way to show them, falls back to pixel or art.
function choose(    i, f, k, n, parts, kv, weight, total, r, pool, np, held, nh) {
  for (i = 1; i <= nfiles; i++) { f = flavor_of(files[i]); found[f]++; byflavor[f, found[f]] = files[i] }
  if (imager == "none") found["image"] = 0
  if (nocolor) found["pixel"] = found["image"] = 0

  f = flavor
  sub(/^images$/, "image", f); sub(/^pixels$/, "pixel", f); sub(/^ascii$/, "art", f)
  if (f !~ /^(art|pixel|braille|image)$/) {
    n = split(ENVIRON["GREETING_WEIGHTS"] == "" ? "art:4 pixel:3 braille:2 image:1" : ENVIRON["GREETING_WEIGHTS"], parts, " ")
    total = 0
    for (i = 1; i <= n; i++) {
      split(parts[i], kv, ":")
      if (found[kv[1]] > 0 && kv[2] > 0) { weight[kv[1]] = kv[2]; total += kv[2] }
    }
    f = ""
    r = rand() * total
    for (k in weight) if (f == "" && (r -= weight[k]) < 0) f = k
  }
  if (f == "image" && !found["image"]) f = found["pixel"] ? "pixel" : "art"
  if (!found[f]) f = "art"
  style = f

  np = found[f]
  for (i = 1; i <= np; i++) pool[i] = byflavor[f, i]
  if (ENVIRON["GREETING_HOLIDAYS"] != "off" && (held = holiday()) != "")
    for (i = 1; i <= np; i++) if (index(held, " " basename(pool[i]) " ")) keep[++nh] = pool[i]
  if (nh) return keep[int(rand() * nh) + 1]
  return pool[int(rand() * np) + 1]
}

function holiday() {
  if (mmdd >= 1025 && mmdd <= 1031) return " ghost skeleton vampire mummy witch zombie werewolf pumpkin "
  if (mmdd >= 1220 && mmdd <= 1226) return " santa snowman elf "
  return ""
}

function basename(path) {
  sub(/.*\//, "", path)
  sub(/\.[^.]*$/, "", path)
  return path
}

function nudge() {
  return pick("Go to bed. The bug will still be there tomorrow, and you will be smarter.|" \
    "Nothing good gets committed after 2 a.m.|" \
    "Sleep is the best debugger.|" \
    "Future you has to review this code. Get some sleep.") "\n    -- your terminal"
}

function greeting(    s, i) {
  if (hour >= 5 && hour < 12) s = pick("Good morning, @!|Morning, @. Coffee first.|Rise and shine, @!")
  else if (hour >= 12 && hour < 17) s = pick("Good afternoon, @!|Afternoon, @. Halfway there.|Hey @, hope the day is going well.")
  else if (hour >= 17 && hour < 22) s = pick("Good evening, @!|Evening, @. Wrapping up?|Hi @, nice work today.")
  else s = pick("Working late, @?|Hello, night owl @.|Burning the midnight oil, @?")
  i = index(s, "@")
  return substr(s, 1, i - 1) name substr(s, i + 1)
}

# One random fact about today or this computer, read from date, uptime, df and the counter
function fact(    f, n, day, days, unit) {
  split("Monday Tuesday Wednesday Thursday Friday Saturday Sunday", day, " ")
  if (weekday == 1) f[++n] = pick("Monday again. You got this.|New week, new commits.")
  else if (weekday == 5) f[++n] = pick("Happy Friday!|It is Friday. Deploy with care.")
  else if (weekday >= 6) f[++n] = pick("Weekend coding? Respect.|It is the weekend. Take a break too.")
  else f[++n] = pick("Happy " day[weekday] "!|It is " day[weekday] ". Keep going.")

  if (match(uptime, /up [0-9]+ day/)) {
    days = substr(uptime, RSTART + 3, RLENGTH - 7) + 0
    unit = days == 1 ? " day" : " days"
    if (days >= 14) f[++n] = pick("Up " days unit ". Maybe restart soon?|" days unit " without a reboot. Impressive, or overdue.")
    else f[++n] = pick("Up " days unit " and counting.|This computer has been awake for " days unit ".")
  } else if (uptime ~ /up/) f[++n] = pick("Fresh boot today.|Freshly restarted. Clean slate.")

  if (disk >= 95) f[++n] = "Disk " disk "% full! Time to free some space."
  else if (disk >= 80) f[++n] = pick("Disk " disk "% full. Time to clean up?|Your disk is " disk "% full.")

  if (count == 1) f[++n] = pick("First terminal of the day!|Terminal number one today. Welcome back.")
  else f[++n] = pick("Terminal #" count " today.|That is terminal number " count " today.")

  return f[int(rand() * n) + 1]
}

# Same as `fold -s`: break at the last space that fits, or mid-word if there is none
function wrap(line,    p) {
  while (length(line) > WIDTH) {
    for (p = WIDTH; p > 0 && substr(line, p, 1) != " "; p--) ;
    if (p == 0) p = WIDTH
    add(substr(line, 1, p))
    line = substr(line, p + 1)
  }
  add(line)
}

function add(s) {
  sub(/ +$/, "", s)
  text[++ntext] = s
  if (length(s) > w) w = length(s)
}

# art: the classic cowsay bubble
function bubble(    i, left, right) {
  say(" " repeat("_", w + 2))
  if (ntext == 1) say("< " text[1] " >")
  else for (i = 1; i <= ntext; i++) {
    left = "|"; right = "|"
    if (i == 1) { left = "/"; right = "\\" }
    if (i == ntext) { left = "\\"; right = "/" }
    say(left " " text[i] repeat(" ", w - length(text[i])) " " right)
  }
  say(" " repeat("-", w + 2))
}

# pixel and braille: a box drawn with Unicode lines; "stem" joins the tail to the bottom edge
function box(tl, tr, bl, br, stem,    i, h) {
  h = "\342\224\200"
  say(tl repeat(h, w + 2) tr)
  for (i = 1; i <= ntext; i++) say("\342\224\202 " text[i] repeat(" ", w - length(text[i])) " \342\224\202")
  if (stem == "") say(bl repeat(h, w + 2) br)
  else say(bl h stem repeat(h, w) br)
}

function tail(c) {
  if (style == "pixel") { say("   " c); say("    " c) }
  else say("  " c)
}

# image: a minimal caption card with an accent bar
function card(    i) {
  for (i = 1; i <= ntext; i++) say("\342\226\214 " text[i])
}

function art(file,    line) {
  while ((getline line < file) > 0) say(line)
  close(file)
}

# pixel files: a palette ("k #1b1b1b", ". transparent"), a line "---", then the pixel grid.
# Two pixel rows share one text row: the top pixel is the color of a half block, the bottom its background.
function sprite(file,    line, grid, pal, nr, y, x, top, bot, t, b, out) {
  while ((getline line < file) > 0) {
    if (line == "---") grid = 1
    else if (grid) rows[++nr] = line
    else pal[substr(line, 1, 1)] = substr(line, 3)
  }
  close(file)
  for (y = 1; y <= nr; y += 2) {
    out = "    "
    top = rows[y]; bot = y < nr ? rows[y + 1] : ""
    for (x = 1; x <= length(top); x++) {
      t = pal[substr(top, x, 1)]; b = bot == "" ? "transparent" : pal[substr(bot, x, 1)]
      if (t == "transparent" && b == "transparent") out = out "\033[0m "
      else if (b == "transparent") out = out "\033[0m" hex("38", t) "\342\226\200"
      else if (t == "transparent") out = out "\033[0m" hex("38", b) "\342\226\204"
      else out = out hex("38", t) hex("48", b) "\342\226\200"
    }
    print out "\033[0m"
  }
}

function hex(layer, h,    digits) {
  digits = "0123456789abcdef"
  h = tolower(h)
  return color(layer, \
    (index(digits, substr(h, 2, 1)) - 1) * 16 + index(digits, substr(h, 3, 1)) - 1, \
    (index(digits, substr(h, 4, 1)) - 1) * 16 + index(digits, substr(h, 5, 1)) - 1, \
    (index(digits, substr(h, 6, 1)) - 1) * 16 + index(digits, substr(h, 7, 1)) - 1)
}

# Shows a picture with chafa, or the iTerm2 image escape code. The path goes to sh in single quotes.
function image(file,    parts, n, i, q, size, cmd) {
  n = split(file, parts, "\047")
  q = parts[1]
  for (i = 2; i <= n; i++) q = q "\047\\\047\047" parts[i]
  size = ENVIRON["GREETING_IMAGE_SIZE"] == "" ? "24x12" : ENVIRON["GREETING_IMAGE_SIZE"]
  if (imager == "chafa") cmd = "chafa --size=" size " --animate=off \047" q "\047"
  else {
    split(size, parts, "x")
    cmd = "printf \"\\033]1337;File=inline=1;width=" parts[1] ";height=" parts[2] ";preserveAspectRatio=1:\"; " \
      "base64 < \047" q "\047 | tr -d \"\\n\"; printf \"\\a\\n\""
  }
  fflush()
  system(cmd)
}

# art colors every letter (a lolcat-style rainbow); the other flavors color whole lines, so
# multibyte characters are never split: pastel for pixel, one rainbow color per row for braille,
# a single accent for image. Shiny turns everything gold.
function say(s,    i, out, f) {
  if (style == "art") {
    out = ""
    for (i = 1; i <= length(s); i++) out = out tint(0.1 * (offset + row + i / 3)) substr(s, i, 1)
  } else if (style == "image") out = (shiny ? color("38", 255, 215, 0) : color("38", 137, 180, 250)) s
  else out = tint(0.35 * (offset / 10 + row)) s
  print out RESET
  row++
}

function tint(f,    r, g, b) {
  if (shiny) return color("38", 255, 215, 0)
  r = int(sin(f) * 127 + 128)
  g = int(sin(f + 2.094) * 127 + 128)
  b = int(sin(f + 4.189) * 127 + 128)
  if (style == "pixel") { r = int((r + 510) / 3); g = int((g + 510) / 3); b = int((b + 510) / 3) }
  return color("38", r, g, b)
}

# layer 38 is the text color, 48 the background; 256-color fallback when truecolor is not advertised
function color(layer, r, g, b) {
  if (nocolor) return ""
  if (truecolor) return "\033[" layer ";2;" r ";" g ";" b "m"
  return "\033[" layer ";5;" (16 + 36 * int(r * 6 / 256) + 6 * int(g * 6 / 256) + int(b * 6 / 256)) "m"
}

function repeat(c, n,    s) {
  s = ""
  while (n-- > 0) s = s c
  return s
}
' "$@"
