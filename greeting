#!/bin/sh
# Random quote from quotes.txt spoken by a random graphic from graphics/, in rainbow colors.
# Only POSIX sh and awk, so any shell on macOS, Linux, BSD or WSL can run it.

dir=$(cd "$(dirname "$0")" && pwd)
seed=$(od -An -N4 -tu4 /dev/urandom | tr -d ' ')
read -r today hour weekday <<EOF
$(date '+%Y%m%d %H %u')
EOF
g=$dir/graphics

if [ $# -eq 0 ]; then
  case ${today#????} in
    102[5-9] | 103[01])
      set -- "$g/ghost.txt" "$g/skeleton.txt" "$g/vampire.txt" "$g/mummy.txt" \
        "$g/witch.txt" "$g/zombie.txt" "$g/werewolf.txt" ;;
    122[0-6]) set -- "$g/santa.txt" "$g/snowman.txt" "$g/elf.txt" ;;
    *) set -- "$g"/*.txt ;;
  esac
fi

# Terminals opened today. This is the only thing written to disk: a date and a count.
state=${XDG_STATE_HOME:-$HOME/.local/state}/shell-greeting
count=1
if [ -r "$state/count" ]; then
  read -r day n < "$state/count"
  case $n in '' | *[!0-9]*) ;; *) [ "$day" = "$today" ] && count=$((n + 1)) ;; esac
fi
mkdir -p "$state" 2>/dev/null && { echo "$today $count" > "$state/count"; } 2>/dev/null

exec awk -v seed="$seed" -v hour="$hour" -v weekday="$weekday" -v count="$count" \
  -v name="${GREETING_NAME:-${USER:-$(id -un)}}" -v uptime="$(uptime 2>/dev/null)" \
  -v disk="$(df -P "$HOME" 2>/dev/null | awk 'NR == 2 { print $5 + 0 }')" '
BEGIN {
  srand(seed)
  WIDTH = 50
  offset = int(rand() * 256)
  shiny = rand() < 0.02
  truecolor = ENVIRON["COLORTERM"] ~ /^(truecolor|24bit)$/
  for (i = 2; i < ARGC; i++) { graphics[++ngraphics] = ARGV[i]; ARGV[i] = "" }
}

# quotes.txt uses the fortune format: entries separated by a line containing only "%"
$0 == "%" { if (entry != "") quotes[++nquotes] = entry; entry = ""; next }
{ if (entry == "") entry = $0; else entry = entry "\n" $0 }

END {
  if (entry != "") quotes[++nquotes] = entry
  quote = quotes[int(rand() * nquotes) + 1]
  if (hour >= 1 && hour < 5) quote = nudge()
  n = split(quote, lines, "\n")
  for (i = 1; i <= n; i++) wrap(lines[i])
  paint(greeting())
  bubble()
  graphic(graphics[int(rand() * ngraphics) + 1])
  paint("   " fact())
  if (shiny) paint("      * shiny! *")
}

# The awk program sits inside single quotes, so its messages avoid apostrophes.
function pick(options,    n, a) {
  n = split(options, a, "|")
  return a[int(rand() * n) + 1]
}

function nudge() {
  return pick("Go to bed. The bug will still be there tomorrow, and you will be smarter.|" \
    "Nothing good gets committed after 2 a.m.|" \
    "Sleep is the best debugger.|" \
    "Future you has to review this code. Get some sleep.") "\n    -- your terminal"
}

function greeting(    s, i) {
  if (hour >= 5 && hour < 12) s = pick("Good morning, @!|Morning, @. Coffee first.|Rise and shine, @!")
  else if (hour >= 12 && hour < 17) s = pick("Good afternoon, @!|Afternoon, @. Halfway there.|Hey @, hope the day is going well.")
  else if (hour >= 17 && hour < 22) s = pick("Good evening, @!|Evening, @. Wrapping up?|Hi @, nice work today.")
  else s = pick("Working late, @?|Hello, night owl @.|Burning the midnight oil, @?")
  i = index(s, "@")
  return substr(s, 1, i - 1) name substr(s, i + 1)
}

# One random fact about today or this computer, read from date, uptime, df and the counter
function fact(    f, n, day, days, unit) {
  split("Monday Tuesday Wednesday Thursday Friday Saturday Sunday", day, " ")
  if (weekday == 1) f[++n] = pick("Monday again. You got this.|New week, new commits.")
  else if (weekday == 5) f[++n] = pick("Happy Friday!|It is Friday. Deploy with care.")
  else if (weekday >= 6) f[++n] = pick("Weekend coding? Respect.|It is the weekend. Take a break too.")
  else f[++n] = pick("Happy " day[weekday] "!|It is " day[weekday] ". Keep going.")

  if (match(uptime, /up [0-9]+ day/)) {
    days = substr(uptime, RSTART + 3, RLENGTH - 7) + 0
    unit = days == 1 ? " day" : " days"
    if (days >= 14) f[++n] = pick("Up " days unit ". Maybe restart soon?|" days unit " without a reboot. Impressive, or overdue.")
    else f[++n] = pick("Up " days unit " and counting.|This computer has been awake for " days unit ".")
  } else if (uptime ~ /up/) f[++n] = pick("Fresh boot today.|Freshly restarted. Clean slate.")

  if (disk >= 95) f[++n] = "Disk " disk "% full! Time to free some space."
  else if (disk >= 80) f[++n] = pick("Disk " disk "% full. Time to clean up?|Your disk is " disk "% full.")

  if (count == 1) f[++n] = pick("First terminal of the day!|Terminal number one today. Welcome back.")
  else f[++n] = pick("Terminal #" count " today.|That is terminal number " count " today.")

  return f[int(rand() * n) + 1]
}

# Same as `fold -s`: break at the last space that fits, or mid-word if there is none
function wrap(line,    p) {
  while (length(line) > WIDTH) {
    for (p = WIDTH; p > 0 && substr(line, p, 1) != " "; p--) ;
    if (p == 0) p = WIDTH
    add(substr(line, 1, p))
    line = substr(line, p + 1)
  }
  add(line)
}

function add(s) {
  sub(/ +$/, "", s)
  text[++ntext] = s
  if (length(s) > w) w = length(s)
}

function bubble(    i, left, right) {
  paint(" " repeat("_", w + 2))
  if (ntext == 1) paint("< " text[1] " >")
  else for (i = 1; i <= ntext; i++) {
    left = "|"; right = "|"
    if (i == 1) { left = "/"; right = "\\" }
    if (i == ntext) { left = "\\"; right = "/" }
    paint(left " " text[i] repeat(" ", w - length(text[i])) " " right)
  }
  paint(" " repeat("-", w + 2))
}

function graphic(file,    line) {
  while ((getline line < file) > 0) paint(line)
  close(file)
}

# Same sine-wave rainbow as lolcat (frequency 0.1, spread 3), or solid gold for a shiny;
# 256-color fallback when truecolor is not advertised
function paint(s,    out, i, f, r, g, b) {
  out = ""
  for (i = 1; i <= length(s); i++) {
    if (shiny) { r = 255; g = 215; b = 0 }
    else {
      f = 0.1 * (offset + row + i / 3)
      r = int(sin(f) * 127 + 128)
      g = int(sin(f + 2.094) * 127 + 128)
      b = int(sin(f + 4.189) * 127 + 128)
    }
    if (truecolor) out = out sprintf("\033[38;2;%d;%d;%dm", r, g, b)
    else out = out sprintf("\033[38;5;%dm", 16 + 36 * int(r * 6 / 256) + 6 * int(g * 6 / 256) + int(b * 6 / 256))
    out = out substr(s, i, 1)
  }
  print out "\033[0m"
  row++
}

function repeat(c, n,    s) {
  s = ""
  while (n-- > 0) s = s c
  return s
}
' "$dir/quotes.txt" "$@"
